# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/mern_blog_db

# Security & JWT Tokens
JWT_ACCESS_SECRET=access_secret_super_secure_key_123456789!
JWT_REFRESH_SECRET=refresh_secret_super_secure_key_987654321!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_TO_DB=true

# OAuth (Optional / Simulated fallback provided for local testing)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
